{
  "rules": {
    // ================================================================
    // AM PREMIUM GENERATOR V2.0 — Firebase Realtime Database Rules
    // Prinsip: least-privilege, semua deny by default
    // Server-side validation dilakukan via Firebase Admin SDK
    // ================================================================

    ".read": false,
    ".write": false,

    // ----------------------------------------------------------------
    // users/{uid}
    // ----------------------------------------------------------------
    "users": {
      "$uid": {
        // User hanya bisa baca datanya sendiri
        ".read": "auth !== null && auth.uid === $uid",
        // User TIDAK bisa menulis langsung (hanya admin/server via Admin SDK)
        ".write": false,

        // Validasi field-level untuk mencegah penulisan langsung yang tidak valid
        // (Admin SDK melewati rules ini, tapi berguna jika ada client yg mencoba bypass)
        "role": {
          ".validate": "newData.isString() && newData.val().matches(/^(user|premium|moderator|admin|owner)$/)"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(active|suspended)$/)"
        },
        "dailyLimit": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "usedToday": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    // ----------------------------------------------------------------
    // usernames/{username}
    // Mapping username -> {uid, email}
    // Read-only dari client (lookup untuk login)
    // ----------------------------------------------------------------
    "usernames": {
      "$username": {
        // Siapa saja yang sudah login bisa membaca (untuk username login)
        ".read": "auth !== null",
        // Hanya server via Admin SDK yang bisa menulis
        ".write": false
      }
    },

    // ----------------------------------------------------------------
    // usage/{uid}/{requestId}
    // Riwayat penggunaan generator per user
    // ----------------------------------------------------------------
    "usage": {
      "$uid": {
        // User hanya bisa baca riwayat sendiri
        ".read": "auth !== null && auth.uid === $uid",
        // Hanya server yang bisa menulis
        ".write": false
      }
    },

    // ----------------------------------------------------------------
    // system/
    // Pengaturan dan statistik global sistem
    // ----------------------------------------------------------------
    "system": {
      // Settings publik (maintenance, versi) bisa dibaca siapa saja
      "settings": {
        ".read": true,
        ".write": false
      },
      "stats": {
        ".read": false,
        ".write": false
      },
      "emails": {
        ".read": false,
        ".write": false
      }
    },

    // ----------------------------------------------------------------
    // redeemCodes/
    // Hanya server yang bisa baca/tulis
    // ----------------------------------------------------------------
    "redeem": {
      ".read": false,
      ".write": false
    },

    // ----------------------------------------------------------------
    // emails/
    // Email sistem. Server (Admin SDK) memfilter dengan orderByChild:
    // tanpa .indexOn, seluruh node diunduh dulu lalu difilter di server (lambat).
    // ----------------------------------------------------------------
    "emails": {
      ".read": false,
      ".write": false,
      ".indexOn": ["email", "authorized", "status"]
    },

    // ----------------------------------------------------------------
    // announcements/
    // Siapa saja yang sudah login bisa membaca
    // Hanya server yang bisa menulis
    // ----------------------------------------------------------------
    "announcements": {
      ".read": "auth !== null",
      ".write": false,
      ".indexOn": ["active"]
    },

    // ----------------------------------------------------------------
    // adminLogs/
    // Hanya server via Admin SDK yang bisa baca/tulis
    // ----------------------------------------------------------------
    "adminLogs": {
      ".read": false,
      ".write": false,
      ".indexOn": ["createdAt"]
    },

    // ----------------------------------------------------------------
    // pendingRequests/
    // State sementara generator (server-managed)
    // ----------------------------------------------------------------
    "pendingRequests": {
      ".read": false,
      ".write": false
    },

    // ----------------------------------------------------------------
    // userPhotos/ & userThumbs/
    // Foto profil (256px) dan thumbnail (64px), dipisah dari users/{uid}
    // supaya node users tetap kecil. Hanya server.
    // ----------------------------------------------------------------
    "userPhotos": {
      ".read": false,
      ".write": false
    },
    "userThumbs": {
      ".read": false,
      ".write": false
    },

    // ----------------------------------------------------------------
    // chat/ — Global Chat
    //  messages, pin, stickers : semua user login boleh BACA (realtime); tulis hanya server (Admin SDK)
    //  presence/{uid}          : user hanya boleh menulis status online miliknya sendiri
    // chatMedia/, chatSticker/ : data gambar/stiker, hanya server (disajikan lewat /api/chat/media|sticker/:id)
    // ----------------------------------------------------------------
    "chat": {
      "messages": {
        ".read": "auth !== null",
        ".write": false,
        ".indexOn": ["ts"]
      },
      "pin": {
        ".read": "auth !== null",
        ".write": false
      },
      "stickers": {
        ".read": "auth !== null",
        ".write": false
      },
      "presence": {
        ".read": "auth !== null",
        "$uid": {
          ".write": "auth !== null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['ts', 'name']) && newData.child('ts').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 40",
          "ts": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    "chatMedia": {
      ".read": false,
      ".write": false
    },
    "chatSticker": {
      ".read": false,
      ".write": false
    },

    // ----------------------------------------------------------------
    // rateLimits/
    // Penghitung rate limit lintas instance (server-managed)
    // ----------------------------------------------------------------
    "rateLimits": {
      ".read": false,
      ".write": false,
      ".indexOn": ["resetAt"]
    }
  }
}
