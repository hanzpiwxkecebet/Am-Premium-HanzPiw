{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:page(login|register|dashboard|generator|history|redeem|updates|profile|admin|owner|maintenance)",
      "has": [
        {
          "type": "query",
          "key": "_embed"
        }
      ],
      "destination": "/pages/:page.html"
    },
    {
      "source": "/:page(login|register|dashboard|generator|history|redeem|updates|profile|admin|owner|maintenance)",
      "destination": "/shell.html"
    },
    {
      "source": "/menu-tidak-ditemukan",
      "destination": "/404.html"
    }
  ],
  "redirects": [
    {
      "source": "/pages/:path*",
      "destination": "/menu-tidak-ditemukan",
      "permanent": false
    }
  ]
}
