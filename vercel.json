{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/register",
      "destination": "/pages/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/pages/dashboard.html"
    },
    {
      "source": "/generator",
      "destination": "/pages/generator.html"
    },
    {
      "source": "/history",
      "destination": "/pages/history.html"
    },
    {
      "source": "/redeem",
      "destination": "/pages/redeem.html"
    },
    {
      "source": "/updates",
      "destination": "/pages/updates.html"
    },
    {
      "source": "/profile",
      "destination": "/pages/profile.html"
    },
    {
      "source": "/admin",
      "destination": "/pages/admin.html"
    },
    {
      "source": "/owner",
      "destination": "/pages/owner.html"
    },
    {
      "source": "/maintenance",
      "destination": "/pages/maintenance.html"
    },
    {
      "source": "/menu-tidak-ditemukan",
      "destination": "/404.html"
    }
  ],
  "redirects": [
    {
      "source": "/pages/:path*",
      "destination": "/menu-tidak-ditemukan",
      "permanent": false
    }
  ]
}
